# Dr. Rattan ENT Clinic - Environment Configuration Example
# Copy this file to .env.local for local development or configure these variables in the Netlify Dashboard

# Admin authentication secret key for session tokens (Required in production)
JWT_SECRET=your_jwt_secret_key_here

# Public site domain URL (used for canonical tags, Open Graph and sitemap)
NEXT_PUBLIC_SITE_URL=https://drrattanentclinic.com

# Node environment
NODE_ENV=production

# --- Multi-Tier Persistence Options ---
# 1. Netlify Blobs (Primary on Netlify - works automatically in Netlify Functions)
# If using manual credentials or cross-environment access:
# NETLIFY_SITE_ID=your_site_id_here
# NETLIFY_AUTH_TOKEN=your_netlify_personal_access_token

# 2. Upstash Redis / Vercel KV (Optional Secondary Tier)
# UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# 3. GitHub API Persistence (Optional Tertiary Tier - automatically commits content changes to repo)
# GITHUB_TOKEN=ghp_your_github_token
# GITHUB_REPO=owner/repo
# GITHUB_BRANCH=main

